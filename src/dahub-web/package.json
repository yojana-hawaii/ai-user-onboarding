{
  "name": "dahub-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "ng serve --port 4200",
    "build": "ng build",
    "test": "ng test --watch=false",
    "format:check": "prettier --check src e2e *.json *.cjs *.mjs playwright.config.ts",
    "format": "prettier --write src e2e *.json *.cjs *.mjs playwright.config.ts",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "overrides": {
    "minimatch@>=10.0.0 <11.0.1": "11.0.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.0",
    "vitest": "4.1.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "typescript-eslint": "8.72.1",
    "angular-eslint": "22.6.0",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "4.1.12"
  }
}
