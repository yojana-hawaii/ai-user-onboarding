    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.0",
    "vitest": "^4.0.0"
  }
